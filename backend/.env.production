# Production Polar config — checked into git. Only PUBLIC values belong here:
# a checkout link and an organization id are both meant to be visible to an
# untrusted client (they're baked into every shipped copy of the app). Do
# NOT add POLAR_PRODUCTION_API_KEY here — the shipped app never needs it
# (license validate/activate are unauthenticated Polar endpoints by design;
# see app/licensing/polar_client.py). Fill in the real values below before
# using `task package:production`.
POLAR_USE_SANDBOX=false
POLAR_PRODUCTION_ORGANIZATION_ID=REPLACE_ME
POLAR_PRODUCTION_CHECKOUT_URL=REPLACE_ME
